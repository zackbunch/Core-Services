# Copy to terraform.tfvars and replace these examples with your Proxmox values.
# No API tokens, passwords, or private keys belong in this file.
proxmox_endpoint = "https://pve.example.com:8006/"
proxmox_node     = "pve"

# Provider uploads cloud-init snippets through node SSH using your ssh-agent.
proxmox_ssh_username = "root"

vm_name = "coreservices-dev"
# vm_id = 120

vm_datastore_id      = "local-lvm"
image_datastore_id   = "local"
snippet_datastore_id = "local" # Must permit snippets in Proxmox storage settings.
network_bridge      = "vmbr0"
# vlan_id = 20

ssh_username = "admin"
ssh_public_keys = [
  "ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY workstation"
]

# DHCP: create a reservation after the VM's MAC is known.
ipv4_address = "dhcp"
# dns_servers = ["192.168.10.1"]

# Alternatively, use a free IP in your LAN and its actual gateway:
# ipv4_address = "192.168.10.50/24"
# ipv4_gateway = "192.168.10.1"
# dns_servers  = ["192.168.10.1"]

# For reproducibility, choose a dated Ubuntu image and copy the matching SHA256
# from Ubuntu's verified/signed SHA256SUMS, rather than inventing a hash.
# ubuntu_image_url    = "https://cloud-images.ubuntu.com/noble/RELEASE/noble-server-cloudimg-amd64.img"
# ubuntu_image_sha256 = "REPLACE_WITH_VERIFIED_64_CHARACTER_SHA256"
