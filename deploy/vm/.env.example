# Internal DNS zone owned/managed by you. Create keycloak, vault, mailpit, minio,
# and s3 records under this zone pointing to the VM. Do not use .localhost.
CORE_DOMAIN=dev.example.com

# Generate unique secrets with a password manager. Required values are deliberately
# empty so an unedited copy fails validation. Single-quote values containing $ or #
# to prevent Compose dotenv interpolation. Never commit the populated .env file.
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Optional image overrides. Pin tested tags/digests before long-lived deployments.
MAILPIT_IMAGE=axllent/mailpit:latest
MINIO_IMAGE=quay.io/minio/minio:latest
