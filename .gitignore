.env
*.env
!.env.example
.DS_Store

# Local/editor noise
.vscode/*.log

# Local certs or exported secrets
*.crt
*.key
*.pem

# Optional bind-mounted data directories
**/data/

# Terraform runtime data and deployment-specific inputs (may contain secrets)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
*.tfvars.json
crash.log
crash.*.log
# Keep provider lock files and *.tfvars.example templates tracked.
